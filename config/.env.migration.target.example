# Copy to: config/.env.migration.target
# That file is gitignored — do not commit secrets.
#
# Use this file ONLY when running migration *import* scripts against the
# destination tenant. Do not replace config/.env.dev for day-to-day dev.

# --- Azure AD app (destination tenant or multi-tenant app) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# SharePoint hostname prefix for the *target* tenant (Graph + SPO token)
TENANT_NAME=mycsproject25

# Optional: source site root URL (no trailing slash). If unset, import uses export `site/site.json` webUrl.
# MIGRATION_SOURCE_SITE_URL=https://oldtenant.sharepoint.com/sites/OldSite

# When true (default), list item field strings that contain the source site URL get that prefix replaced
# with the target site URL (rich text, hyperlinks, plain text URLs).
# MIGRATION_REWRITE_SOURCE_SITE_URLS=true

# Default true: add one day to EventDate on Graph create for all-day Events (Graph off-by-one). Set false if dates import one day late.
# MIGRATION_GRAPH_ALLDAY_EVENTDATE_PLUS_ONE=true

# Site path segment: https://{TENANT_NAME}.sharepoint.com/sites/{MIGRATION_TARGET_SITE_NAME}
MIGRATION_TARGET_SITE_NAME=PD-Intranet

# Folder that contains export output (lists/, list_items/, libraries/, pages/, …)
# Relative paths are resolved from the repository root.
MIGRATION_EXPORT_DIR=scripts/py/migration/.migration_output

# If true, import scripts log actions but skip POST/PUT/PATCH (safe rehearsal)
MIGRATION_DRY_RUN=false

# Comma-separated list internal names to never auto-create on target (defaults shown)
# MIGRATION_LIST_BLOCKLIST=users,TaxonomyHiddenList

# Skip export index rows with system=true (default true)
# MIGRATION_SKIP_SYSTEM_LISTS=true
